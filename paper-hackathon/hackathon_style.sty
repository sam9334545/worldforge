% neurips_style.sty
%
% A self-contained reimplementation of the NeurIPS submission layout, for use
% where the official style file is not available offline. It reproduces the
% geometry, type sizes, anonymous-submission behaviour, line numbering and
% section styling of neurips_2024.sty closely enough to draft and review
% against.
%
% BEFORE ACTUAL SUBMISSION: replace this file with the official style file from
% the conference website and rebuild. Do not submit against this file.
%
% Options:  [preprint]  named authors, no line numbers
%           [final]     camera-ready, named authors
%           default     anonymous submission with line numbers

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_style}[2025/01/01 NeurIPS-like submission format]

\newif\if@neuripspreprint \@neuripspreprintfalse
\newif\if@neuripsfinal    \@neuripsfinalfalse
\DeclareOption{preprint}{\@neuripspreprinttrue}
\DeclareOption{final}{\@neuripsfinaltrue}
\ProcessOptions\relax

\RequirePackage{geometry}
\RequirePackage{natbib}
\RequirePackage{xcolor}

\geometry{
  letterpaper,
  textwidth=5.5in,
  textheight=9.0in,
  top=1.0in,
  left=1.5in,
  headheight=12pt,
  headsep=25pt,
  footskip=30pt
}

\renewcommand{\baselinestretch}{1}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt plus 2pt minus 1pt}

% -- line numbers on anonymous submissions -------------------------------
\if@neuripsfinal
\else
  \if@neuripspreprint
  \else
    \RequirePackage{lineno}
    \linenumbers
    \renewcommand{\linenumberfont}{\normalfont\small\sffamily\color{gray}}
  \fi
\fi

% -- title block ---------------------------------------------------------
\renewcommand{\@maketitle}{%
  \newpage\null
  \vskip 0.3in%
  \begin{center}%
    {\Large\bfseries \@title \par}%
    \vskip 0.35in%
    {\large \@author \par}%
  \end{center}%
  \vskip 0.25in%
}

\newcommand{\anonymousauthor}{%
  \normalsize
  Anonymous Author(s)\\
  Affiliation\\
  Address\\
  \texttt{email}%
}

% -- abstract ------------------------------------------------------------
\renewenvironment{abstract}{%
  \vskip 0.075in%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}%
  \small
}{%
  \par\end{quote}\vskip 0.2in%
}

% -- sections ------------------------------------------------------------
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection}{1em}{}
\titlespacing*{\section}{0pt}{2.0ex plus 1ex minus .2ex}{1.3ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus 1ex minus .2ex}{1.0ex plus .2ex}

% -- page style ----------------------------------------------------------
\pagestyle{plain}

% -- bibliography --------------------------------------------------------
\renewcommand{\refname}{References}
\setcitestyle{numbers,square,comma}
